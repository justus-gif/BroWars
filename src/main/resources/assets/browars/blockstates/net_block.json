{
  "multipart": [
    {
      "apply": {
        "model": "browars:block/net_block_core"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "browars:block/net_block_border_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "browars:block/net_block_border_south"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "browars:block/net_block_border_west"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "browars:block/net_block_border_east"
      }
    }
  ]
}
